 "grammar_points": [
  {
   "id": "gram_l1_0051",
   "curriculum_id": "hsk_3_0",
   "level_id": "hsk3_l1",
   "pattern": "请 + ……（nói lịch sự）",
   "explanation_vi": "Câu cầu khiến dùng để mời hoặc nhờ ai làm gì. Thêm 请 ở đầu câu để nói lịch sự hơn.",
   "usage_note_vi": "Ở bài này chỉ làm quen với 请 và 请问; câu đầy đủ sẽ học ở các bài sau.",
   "common_error_vi": "请 không chỉ có nghĩa “làm ơn”, còn có nghĩa “mời” (ví dụ 我请你).",
   "examples": [
    {
     "hanzi": "您请。",
     "pinyin": "nín qǐng.",
     "meaning_vi": "Mời ngài."
    },
    {
     "hanzi": "请问！",
     "pinyin": "qǐngwèn!",
     "meaning_vi": "Xin hỏi!"
    }
   ],
   "source_ref": "hsk_3_0_2025_11/pdf1219/grammar#p384-51",
   "review_status": "draft_unreviewed"
  }
 ],
